<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="حالت ساده"
        app:titleTextColor="@color/on_primary"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="چند نقطه رو انتخاب کن؛ به‌ترتیب و با فاصله‌ی زمانیِ مشخص، پشت‌سرهم روشون کلیک می‌خوره — بدون هیچ شرط یا تشخیصی."
            android:textSize="13sp"
            android:textColor="@color/app_on_surface_variant"
            android:layout_marginBottom="14dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="فاصله‌ی زمانی بین کلیک‌ها (میلی‌ثانیه)"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIntervalMs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddPoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="➕ افزودن نقطه (روی اپ هدف تپ کن)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviewPoints"
            style="@style/Widget.AutoClickerPro.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="👁 پیش‌نمایش نقاط روی صفحه" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="برای جابه‌جا کردنِ ترتیب، دستگیره‌ی ☰ کنار هر نقطه رو بگیر و بکش."
            android:textSize="11sp"
            android:textColor="@color/app_on_surface_variant"
            android:layout_marginBottom="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSimplePoints"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearPoints"
            style="@style/Widget.AutoClickerPro.Button.Text.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="🗑 پاک‌کردن همه‌ی نقاط" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartSimple"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="▶ شروع" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopSimple"
                style="@style/Widget.AutoClickerPro.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏹ توقف" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
